{{define "report-document"}}<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{displayLabel .Title}} · 911VulScan</title>
<script>{{designJS "shell.js"}}</script>
<style>{{vendorCSS "report.css"}}</style><style>{{designCSS}}</style>
<script>{{vendorJS "chart-4.5.1.umd.min.js"}}</script><script>{{vendorJS "chartjs-plugin-datalabels-2.2.0.min.js"}}</script></head>
<body class="report-page"><a class="skip-link" href="#findings">跳到发现详情</a>
<header class="app-header"><a href="#overview" class="brand"><span class="brand-mark" aria-hidden="true">911</span>911VulScan</a><span class="header-subtitle">安全分析报告</span><div class="header-actions"><nav class="report-top-nav" aria-label="报告导航"><a href="#findings">发现</a><a href="#remediation">修复建议</a><a href="#distribution">扫描范围</a>{{if .HasStepReports}}<a href="#pipeline">执行记录</a>{{end}}</nav><button class="btn theme-toggle" type="button" data-theme-toggle aria-label="深色主题" aria-pressed="false" title="切换为深色主题"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="theme-moon" d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z"/><g class="theme-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg><span data-theme-label>主题</span></button></div></header>
<main class="report-shell">
<header id="overview" class="report-heading"><div><h1>{{if .RepoName}}<span title="代码仓库">{{.RepoName}}</span>{{else}}{{displayLabel .Title}}{{end}}</h1><div class="report-meta">{{if .BrowseURL}}<a href="{{.BrowseURL}}" target="_blank" rel="noopener">仓库</a>{{end}}{{if .ShortCommit}}<code>{{.ShortCommit}}</code>{{end}}{{if .Language}}<span>{{.Language}}</span>{{end}}{{if .IsIncremental}}<span class="status-pill">增量扫描</span><code>{{.DiffRange}}</code><span>{{.Diff.UnitsInDiff}}/{{.Diff.UnitsTotalParsed}} 个函数</span>{{end}}</div></div><div class="report-date"><span>{{.Timestamp}}</span>{{if .FormatDuration}}<span>扫描耗时 {{.FormatDuration}}</span>{{end}}</div></header>
{{$counts := .FindingCounts}}<div class="report-stats" aria-label="发现与验证统计"><div><span>候选问题</span><strong>{{index $counts "candidates"}}</strong></div><div><span>模型复核保留</span><strong>{{index $counts "retained"}}</strong></div><div><span>模型复核排除</span><strong>{{index $counts "excluded"}}</strong></div><div><span>动态已复现</span><strong>{{index $counts "reproduced"}}</strong></div></div>
<div class="report-layout"><aside class="report-sidebar"><h2>发现目录</h2><label for="finding-query" class="visually-hidden">搜索漏洞</label><input id="finding-query" type="search" placeholder="搜索标题、CWE、文件…" autocomplete="off"><p id="finding-count" class="finding-count" role="status"></p><nav class="report-toc" aria-label="发现目录">{{range .NavigationFindings}}<a href="#finding-{{.Number}}" data-finding="finding-{{.Number}}"><span class="toc-number">#{{.Number}}</span><span><strong>{{.DisplayTitle}}</strong><small>{{.File}}</small></span></a>{{else}}<p class="hint">没有已保存的候选</p>{{end}}</nav><details class="report-count-help"><summary>统计口径</summary><p>按报告中 finding_id 去重。模型复核与动态测试分别计数；缺少状态显示“—”。</p></details></aside>
<div class="report-body"><section id="findings"><div class="report-section-heading"><div><h2>发现与分析</h2></div><div class="finding-controls"><button id="finding-expand" type="button">展开全部</button><button id="finding-collapse" type="button">收起全部</button></div></div>
{{if .HasFindingGroups}}<div class="report-groups">{{range .FindingsByVerdict}}<details class="report-group" {{if .OpenByDefault}} open{{end}}><summary><span>{{displayLabel .Verdict}}</span><span class="group-count">{{.Count}} 条</span></summary><div class="report-group-body">{{if .HasSubgroups}}{{range .Subgroups}}<h3 class="subgroup-title">{{dynamicGroupLabel .Label}}</h3>{{range .Findings}}{{template "finding-card" (findingView $ .)}}{{end}}{{end}}{{else}}{{range .Findings}}{{template "finding-card" (findingView $ .)}}{{end}}{{end}}</div></details>{{end}}</div>{{else if .HasFindings}}{{range .Findings}}{{template "finding-card" (findingView $ .)}}{{end}}{{else}}<p class="empty-state">没有已保存的分析记录。</p>{{end}}</section>
<section id="remediation" class="report-supplement"><details><summary>整体修复建议</summary><div class="remediation-content bg-navy-800 rounded-lg p-4 sm:p-6 max-w-none [&_h1]:text-2xl [&_h1]:font-semibold [&_h1]:text-gray-100 [&_h1]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-gray-100 [&_h2]:mb-3 [&_h3]:text-base [&_h3]:sm:text-lg [&_h3]:font-semibold [&_h3]:text-gray-100 [&_h3]:mb-2 [&_h4]:text-sm [&_h4]:sm:text-base [&_h4]:font-semibold [&_h4]:text-gray-100 [&_h4]:mb-2 [&_h5]:text-sm [&_h5]:font-semibold [&_h5]:text-gray-100 [&_h5]:mb-2 [&_h6]:text-sm [&_h6]:font-semibold [&_h6]:text-gray-100 [&_h6]:mb-2 [&_p]:text-gray-300 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-3 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-3 [&_li]:text-gray-300 [&_li]:mb-1 [&_blockquote]:border-l-2 [&_blockquote]:border-gray-600 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-300 [&_blockquote]:mb-3 [&_code]:text-sm [&_code]:bg-navy-900 [&_code]:border [&_code]:border-gray-700 [&_code]:rounded [&_code]:px-1 [&_code]:py-0.5 [&_code]:text-gray-300 [&_pre]:overflow-x-auto [&_pre]:text-sm [&_pre]:bg-navy-900 [&_pre]:border [&_pre]:border-gray-700 [&_pre]:rounded [&_pre]:p-4 [&_pre]:mb-3 [&_kbd]:text-sm [&_samp]:text-sm [&_hr]:border-gray-700 [&_hr]:my-4 [&_table]:w-full [&_table]:border-collapse [&_table]:mb-3 [&_th]:border [&_th]:border-gray-700 [&_th]:px-2 [&_th]:py-1 [&_td]:border [&_td]:border-gray-700 [&_td]:px-2 [&_td]:py-1 [&_strong]:text-gray-100 [&_a]:text-accent [&_a]:underline [&_a:hover]:text-accent">{{if .RemediationHTML}}{{.SafeRemediation}}{{else}}<p class="hint">未提供整体修复建议</p>{{end}}</div></details></section>
<section id="distribution" class="report-supplement"><details open><summary>扫描范围与结果分布 <span class="summary-meta">{{.Stats.TotalUnits}} 个函数 · {{.Stats.TotalFiles}} 个文件</span></summary><div class="distribution-body"><div class="chart-pair"><div><h3>函数</h3><div class="chart-frame"><canvas id="unitChart" role="img" aria-label="函数结论分布饼图"></canvas></div></div><div><h3>文件 · 最高风险结论</h3><div class="chart-frame"><canvas id="fileChart" role="img" aria-label="文件结论分布饼图"></canvas></div></div></div><dl class="category-list">{{range .Categories}}<div><dt>{{displayLabel .Verdict}}</dt><dd>{{displayLabel .Description}}</dd></div>{{end}}</dl><p class="hint">分布按分析函数与文件统计。</p></div></details></section>
{{if .HasStepReports}}<section id="pipeline" class="report-supplement"><details><summary>执行记录 <span class="summary-meta">预估费用 {{.FormatTotalCost}}</span></summary><div class="table-wrap"><table><thead><tr><th>步骤</th><th>耗时</th><th>预估费用</th><th>状态</th></tr></thead><tbody>{{range .StepReports}}<tr><td>{{displayLabel .Step}}</td><td>{{.Duration}}</td><td>{{.Cost}}</td><td class="{{.StatusColor}}">{{displayLabel .Status}}{{if .ErrorCount}} · {{.ErrorCount}} 个错误{{end}}{{if .SkippedReason}} · {{displayLabel .SkippedReason}}{{end}}{{range .Errors}}<p>{{.}}</p>{{end}}</td></tr>{{end}}</tbody><tfoot><tr><th>合计</th><td>{{.FormatDuration}}</td><td>{{.FormatTotalCost}}</td><td>费用按配置费率估算</td></tr></tfoot></table></div></details></section>{{end}}
</div></div><footer class="report-footer"><span>911VulScan · 上游来源：OpenAnt / Knostic</span><details class="report-licenses"><summary>组件许可证</summary><div class="license-text">{{designLicenses}}</div></details></footer></main>
<script>{{designJS "marked-18.1.1.min.js"}}</script><script>{{designJS "dompurify-3.4.17.min.js"}}</script><script>{{designJS "highlight-11.11.1.min.js"}}</script><script>{{designJS "reader.js"}}</script><script>{{designJS "report.js"}}</script>
<script>
Chart.register(ChartDataLabels);
const chartOptions={animation:window.matchMedia('(prefers-reduced-motion: reduce)').matches?false:{duration:160},responsive:true,maintainAspectRatio:true,plugins:{legend:{display:false},datalabels:{color:VulscanChartLabelColor,font:{weight:'bold',size:11},formatter:(value,ctx)=>{const total=ctx.chart.data.datasets[0].data.reduce((a,b)=>a+b,0);const pct=total?Math.round(value/total*100):0;return pct<5?'':ctx.chart.data.labels[ctx.dataIndex]+'\n'+pct+'%';},textAlign:'center'}}};
new Chart(document.getElementById('unitChart'),{type:'doughnut',data:{labels:{{toJSON (displayLabels .UnitChart.Labels)}},datasets:[{data:{{toJSON .UnitChart.Data}}||[],backgroundColor:{{toJSON .UnitChart.Colors}},borderWidth:3,borderColor:getComputedStyle(document.documentElement).getPropertyValue('--paper').trim()}]},options:chartOptions});
new Chart(document.getElementById('fileChart'),{type:'doughnut',data:{labels:{{toJSON (displayLabels .FileChart.Labels)}},datasets:[{data:{{toJSON .FileChart.Data}}||[],backgroundColor:{{toJSON .FileChart.Colors}},borderWidth:3,borderColor:getComputedStyle(document.documentElement).getPropertyValue('--paper').trim()}]},options:chartOptions});
document.addEventListener('vulscan:themechange',()=>{for(const id of ['unitChart','fileChart']){const chart=Chart.getChart(id);if(!chart)continue;chart.data.datasets[0].borderColor=getComputedStyle(document.documentElement).getPropertyValue('--paper').trim();chart.update('none');}});
</script></body></html>{{end}}
{{define "finding-card"}}{{$url := .FileURL}}{{with .Finding}}<details id="finding-{{.Number}}" class="report-finding" data-candidate="{{.InFindingNavigation}}" data-search="{{.Number}} {{.ID}} {{.Title}} {{.DisplayTitle}} {{.CWELabel}} {{.File}} {{.Function}} {{.Verdict}} {{.AttackVector}}"{{if .IsHighSeverity}} open{{end}}><summary><span class="finding-number">#{{.Number}}</span><span class="finding-summary"><strong class="report-finding-title">{{.DisplayTitle}}</strong><span class="finding-location">{{if $url}}<a class="finding-source" href="{{$url}}" target="_blank" rel="noopener">{{.File}}</a>{{else}}{{.File}}{{end}}{{if .Function}} · {{.Function}}{{end}}</span></span>{{if .Severity}}<span class="status-pill" data-severity="{{.Severity}}" title="严重性来源：{{displayLabel .SeveritySource}}">{{displayLabel .Severity}}</span>{{end}}<span class="finding-chevron" aria-hidden="true">⌄</span></summary>
<div class="report-finding-body"><div class="report-verification"><div><span>模型复核</span><strong>{{.ModelReviewLabel}}</strong></div><div><span>动态测试</span><strong>{{dynamicLabel .DynamicTestStatus}}</strong></div></div><div class="finding-classification"><span>{{.CWELabel}}</span>{{if .ID}}<code>{{.ID}}</code>{{end}}</div>
<section class="finding-section"><h3>{{if .HasReportDetails}}问题描述{{else}}分析{{end}}</h3><div class="markdown-prose" data-markdown>{{if .Description}}{{.Description}}{{else if .Analysis}}{{.Analysis}}{{else}}未提供描述{{end}}</div></section>
{{if .HasReportDetails}}<section class="finding-section"><h3>影响</h3><div class="markdown-prose" data-markdown>{{if .Impact}}{{.Impact}}{{else}}未提供影响评估{{end}}</div></section><section class="finding-section"><h3>修复建议</h3><div class="markdown-prose" data-markdown>{{if .Remediation}}{{.Remediation}}{{else}}未提供修复建议{{end}}</div></section>
<div class="report-code-pair"><details><summary>相关代码</summary>{{if .VulnerableCode}}<pre><code data-file="{{.File}}" data-start-line="{{.StartLine}}">{{.VulnerableCode}}</code></pre>{{else}}<p class="hint">未提供代码片段</p>{{end}}</details><details><summary>修复示例 <span class="summary-meta">未测试</span></summary>{{if .SuggestedFix}}<pre><code data-file="{{.File}}">{{.SuggestedFix}}</code></pre>{{else}}<p class="hint">未提供可用的修复代码示例</p>{{end}}</details></div>
<section class="finding-section"><h3>复现步骤</h3><div class="markdown-prose" data-markdown>{{if .StepsToReproduce}}{{.StepsToReproduce}}{{else}}未记录复现步骤{{end}}</div></section>{{end}}
{{if .Stage2Verification}}<details class="finding-record"><summary>模型复核依据</summary><div class="markdown-prose" data-markdown>{{.Stage2Verification}}</div></details>{{end}}
{{if .DynamicTestDetails}}<section class="finding-section"><h3>动态测试结果</h3><p>{{.DynamicSummary}}</p><details class="finding-record"><summary>完整测试输出</summary><pre><code>{{.DynamicTestDetails}}</code></pre></details></section>{{end}}
{{if .Reproduction}}<details class="finding-record"><summary>PoC 构建、运行与输出</summary><pre><code>{{.Reproduction}}</code></pre></details>{{else if .HasReportDetails}}<p class="hint">未记录动态测试输出</p>{{end}}
{{if .AttackVector}}<details class="finding-record"><summary>攻击方式</summary><div class="markdown-prose" data-markdown>{{.AttackVector}}</div></details>{{end}}
{{if .DeferredTo}}<details class="finding-record"><summary>调用关系（Call edges）</summary><p>分析范围 <code>{{.Scope}}</code> · 本条记录仅涵盖当前函数</p><p>关联目标：{{range .DeferredTo}}<code>{{.}}</code> {{end}}</p>{{if .DeferredRowless}}<p class="feedback">无结果记录（已裁剪或尚未分析；no result row (pruned or never analyzed)）：{{range .DeferredRowless}}<code>{{.}}</code> {{end}}</p>{{end}}</details>{{end}}
</div></details>{{end}}{{end}}
