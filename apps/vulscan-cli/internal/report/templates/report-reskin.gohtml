<!-- Modified 2026-10-23 for 911VulScan product branding; attribution retained. -->
<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{displayLabel .Title}}</title>
    {{/* #540: the prebuilt CSS (the choice-1 migration; the runtime compiler was frozen at the dead Play-CDN channel). Same self-containment: template.CSS embed, no CDN. Cascade: this block comes BEFORE the hand-written <style> below — the hand-written rules win at equal specificity, the same order the runtime-injected stylesheet had (appended at head-end AFTER these blocks) reversed only for utility-vs-handcrafted collisions, none observed (one manual render checked). */}}
    <style>{{ vendorCSS "report.css" }}</style>
    <script>{{ vendorJS "chart-4.5.1.umd.min.js" }}</script>
    <script>{{ vendorJS "chartjs-plugin-datalabels-2.2.0.min.js" }}</script>
    <style>
        /* Details marker styling */
        details > summary { cursor: pointer; list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
        details > summary::before {
            content: '\25B6';
            display: inline-block;
            margin-right: 0.5rem;
            font-size: 0.65em;
            transition: transform 0.2s ease;
            color: #6861FF;
        }
        details[open] > summary::before {
            transform: rotate(90deg);
        }
        /* Subtle card hover */
        .card-hover {
            transition: box-shadow 0.3s ease, border-color 0.3s ease;
        }
        .card-hover:hover {
            box-shadow: 0 4px 12px rgba(104, 97, 255, 0.08);
            border-color: #6861FF;
        }
        /* Remediation section: visual separation for priority groups */
        .remediation-content h3 { margin-top: 1.5rem; }
        .remediation-content h4 {
            margin-top: 1.75rem;
            padding-top: 1rem;
            border-top: 1px solid #E8ECF4;
        }
        .remediation-content h4:first-child { border-top: none; margin-top: 0; padding-top: 0; }
        /* Finding reference links */
        .finding-ref {
            color: #6861FF;
            text-decoration: underline;
            text-decoration-color: rgba(104, 97, 255, 0.3);
            text-underline-offset: 2px;
            font-weight: 600;
            font-size: 0.85em;
        }
        .finding-ref:hover {
            text-decoration-color: #6861FF;
        }
    </style>
</head>
<body class="bg-white text-knostic-body font-knostic leading-relaxed">

    <!-- Section Nav Bar -->
    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-knostic-border">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-6 overflow-x-auto text-sm py-3">
            <a href="#overview" class="text-knostic-muted hover:text-knostic-purple whitespace-nowrap transition-colors font-medium">概览</a>
            <a href="#distribution" class="text-knostic-muted hover:text-knostic-purple whitespace-nowrap transition-colors font-medium">分布</a>
            <a href="#remediation" class="text-knostic-muted hover:text-knostic-purple whitespace-nowrap transition-colors font-medium">修复建议</a>
            {{if .HasStepReports}}<a href="#pipeline" class="text-knostic-muted hover:text-knostic-purple whitespace-nowrap transition-colors font-medium">扫描流程</a>{{end}}
            {{if .HasFindings}}<a href="#findings" class="text-knostic-muted hover:text-knostic-purple whitespace-nowrap transition-colors font-medium">发现项</a>{{end}}
        </div>
    </nav>

    <main class="max-w-[1400px] mx-auto p-4 sm:p-6 lg:p-8">

        <!-- Header -->
        <header id="overview" class="mb-10 sm:mb-12 pb-6 sm:pb-8 border-b border-knostic-border">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-knostic-navy mb-1">{{displayLabel .Title}}</h1>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-knostic-muted mt-2">
                        {{if .RepoName}}{{$u := .BrowseURL}}{{if $u}}<a href="{{$u}}" target="_blank" rel="noopener" title="代码仓库" class="text-knostic-navy font-semibold hover:underline">{{.RepoName}}</a>{{else}}<span title="代码仓库"><strong class="text-knostic-navy">{{.RepoName}}</strong></span>{{end}}{{end}}
                        {{if .IsIncremental}}
                            <span class="inline-flex items-center gap-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-knostic-purple text-white px-2 py-0.5 rounded">增量扫描</span>
                                <code class="text-xs bg-knostic-card-bg border border-knostic-border-light px-2 py-0.5 rounded text-knostic-navy" title="基准提交..目标提交">{{.DiffRange}}</code>
                                <span class="text-xs text-knostic-muted" title="差异范围：{{.Diff.Scope}}，{{.Diff.ChangedFiles}} 个文件已变更">{{.Diff.UnitsInDiff}}/{{.Diff.UnitsTotalParsed}} 个代码单元</span>
                            </span>
                        {{else if .ShortCommit}}
                            <code class="text-xs bg-knostic-card-bg border border-knostic-border-light px-2 py-0.5 rounded text-knostic-navy">{{.ShortCommit}}</code>
                        {{end}}
                        {{if .Language}}<span class="capitalize">{{.Language}}</span>{{end}}
                    </div>
                </div>
                <div class="flex flex-col items-start sm:items-end gap-1 text-sm text-knostic-muted shrink-0">
                    {{if .FormatDuration}}<span class="text-knostic-navy font-semibold text-base">{{.FormatDuration}}</span>{{end}}
                    <span>{{.Timestamp}}</span>
                    <span>上游项目：<a href="https://knostic.ai" target="_blank" rel="noopener" class="text-knostic-purple font-semibold hover:text-knostic-purple-hover transition-colors">Knostic</a></span>
                </div>
            </div>
        </header>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4 mb-8">
            <div class="bg-knostic-card-bg border border-knostic-border rounded-card p-4 sm:p-6 text-center card-hover">
                <div class="text-2xl sm:text-3xl font-bold text-knostic-navy">{{.Stats.TotalUnits}}</div>
                <div class="text-knostic-muted text-xs sm:text-sm mt-1">代码单元</div>
            </div>
            <div class="bg-knostic-card-bg border border-knostic-border rounded-card p-4 sm:p-6 text-center card-hover">
                <div class="text-2xl sm:text-3xl font-bold text-knostic-navy">{{.Stats.TotalFiles}}</div>
                <div class="text-knostic-muted text-xs sm:text-sm mt-1">文件</div>
            </div>
            <div class="bg-knostic-card-bg border border-knostic-border rounded-card p-4 sm:p-6 text-center card-hover">
                <div class="text-2xl sm:text-3xl font-bold text-red-500">{{.Stats.Vulnerable}}</div>
                <div class="text-knostic-muted text-xs sm:text-sm mt-1">存在漏洞的单元</div>
            </div>
            <div class="bg-knostic-card-bg border border-knostic-border rounded-card p-4 sm:p-6 text-center card-hover">
                <div class="text-2xl sm:text-3xl font-bold text-orange-500">{{.Stats.Bypassable}}</div>
                <div class="text-knostic-muted text-xs sm:text-sm mt-1">防护可绕过的单元</div>
            </div>
            <div class="bg-knostic-card-bg border border-knostic-border rounded-card p-4 sm:p-6 text-center card-hover">
                <div class="text-2xl sm:text-3xl font-bold text-green-500">{{.Stats.Secure}}</div>
                <div class="text-knostic-muted text-xs sm:text-sm mt-1">安全单元</div>
            </div>
        </div>

        <!-- Distribution Overview -->
        <section id="distribution" class="mb-10 border-l-4 border-knostic-purple pl-4 sm:pl-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-knostic-navy mb-6">结果分布</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-6">
                <div class="bg-white border border-knostic-border rounded-card p-4 sm:p-6 card-hover">
                    <h3 class="text-center text-knostic-muted mb-4 text-sm sm:text-base font-medium">按代码单元</h3>
                    <div class="max-w-full sm:max-w-[350px] mx-auto">
                        <canvas id="unitChart" aria-label="代码单元判定分布饼图" role="img"></canvas>
                    </div>
                </div>
                <div class="bg-white border border-knostic-border rounded-card p-4 sm:p-6 card-hover">
                    <h3 class="text-center text-knostic-muted mb-4 text-sm sm:text-base font-medium">按文件（最高风险判定）</h3>
                    <div class="max-w-full sm:max-w-[350px] mx-auto">
                        <canvas id="fileChart" aria-label="文件判定分布饼图" role="img"></canvas>
                    </div>
                </div>
            </div>

            <!-- Category Legend -->
            <details open class="bg-white border border-knostic-border rounded-card">
                <summary class="px-4 sm:px-6 py-3 text-knostic-navy font-medium text-sm sm:text-base hover:text-knostic-purple transition-colors">
                    判定类别
                </summary>
                <div class="px-4 sm:px-6 pb-4">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-knostic-border">
                                <th class="text-left py-3 px-4 text-knostic-muted font-medium">类别</th>
                                <th class="text-left py-3 px-4 text-knostic-muted font-medium">说明</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range $i, $cat := .Categories}}
                            <tr class="border-b border-knostic-border-light {{if even $i}} bg-knostic-card-bg {{end}}">
                                <td class="py-3 px-4">
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold text-white" style="background-color: {{$cat.Color}}">{{displayLabel $cat.Verdict}}</span>
                                </td>
                                <td class="py-3 px-4 text-knostic-body">{{displayLabel $cat.Description}}</td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </details>
        </section>

        <!-- Remediation Guidance -->
        <section id="remediation" class="mb-10 border-l-4 border-knostic-purple pl-4 sm:pl-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-knostic-navy mb-6">修复建议</h2>
            <div class="remediation-content bg-white border border-knostic-border rounded-card p-4 sm:p-6 card-hover max-w-none
                        [&_h1]:text-2xl [&_h1]:font-semibold [&_h1]:text-knostic-navy [&_h1]:mb-3
                        [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-knostic-navy [&_h2]:mb-3
                        [&_h3]:text-base [&_h3]:sm:text-lg [&_h3]:font-semibold [&_h3]:text-knostic-navy [&_h3]:mb-2
                        [&_h4]:text-sm [&_h4]:sm:text-base [&_h4]:font-semibold [&_h4]:text-knostic-navy [&_h4]:mb-2
                        [&_h5]:text-sm [&_h5]:font-semibold [&_h5]:text-knostic-navy [&_h5]:mb-2
                        [&_h6]:text-sm [&_h6]:font-semibold [&_h6]:text-knostic-navy [&_h6]:mb-2
                        [&_p]:text-knostic-body [&_p]:mb-3
                        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-3
                        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-3
                        [&_li]:text-knostic-body [&_li]:mb-1
                        [&_blockquote]:border-l-2 [&_blockquote]:border-knostic-border [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-knostic-body [&_blockquote]:mb-3
                        [&_code]:text-sm [&_code]:bg-knostic-card-bg [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-knostic-navy [&_code]:border [&_code]:border-knostic-border-light
                        [&_pre]:overflow-x-auto [&_pre]:text-sm [&_pre]:bg-knostic-card-bg [&_pre]:border [&_pre]:border-knostic-border-light [&_pre]:rounded [&_pre]:p-4 [&_pre]:mb-3
                        [&_kbd]:text-sm [&_samp]:text-sm
                        [&_hr]:border-knostic-border [&_hr]:my-4
                        [&_table]:w-full [&_table]:border-collapse [&_table]:mb-3
                        [&_th]:border [&_th]:border-knostic-border-light [&_th]:px-2 [&_th]:py-1
                        [&_td]:border [&_td]:border-knostic-border-light [&_td]:px-2 [&_td]:py-1
                        [&_strong]:text-knostic-navy
                        [&_a]:text-knostic-purple [&_a]:underline [&_a:hover]:text-knostic-purple-hover">
                {{.SafeRemediation}}
            </div>
        </section>

        <!-- Pipeline Costs & Timing -->
        {{if .HasStepReports}}
        <section id="pipeline" class="mb-10 border-l-4 border-knostic-purple pl-4 sm:pl-6">
            <details>
                <summary class="text-xl sm:text-2xl font-semibold text-knostic-navy mb-6 hover:text-knostic-purple transition-colors">
                    扫描步骤预估费用与耗时
                </summary>
                <div class="mt-4">
                    <p class="text-sm mb-4">费用按配置中的模型费率估算；供应商的分时定价、缓存折扣及最终账单可能不同。</p>
                    <!-- Desktop: table -->
                    <div class="hidden sm:block overflow-x-auto bg-white border border-knostic-border rounded-card">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-knostic-border">
                                    <th class="text-left py-3 px-4 text-knostic-muted font-medium">步骤</th>
                                    <th class="text-left py-3 px-4 text-knostic-muted font-medium">耗时</th>
                                    <th class="text-left py-3 px-4 text-knostic-muted font-medium">预估费用</th>
                                    <th class="text-left py-3 px-4 text-knostic-muted font-medium">状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{range $i, $step := .StepReports}}
                                <tr class="border-b border-knostic-border-light {{if even $i}} bg-knostic-card-bg {{end}}">
                                    <td class="py-3 px-4 font-mono text-knostic-navy">{{displayLabel $step.Step}}</td>
                                    <td class="py-3 px-4">{{$step.Duration}}</td>
                                    <td class="py-3 px-4">{{$step.Cost}}</td>
                                    <td class="py-3 px-4 {{$step.StatusColor}} font-medium">{{displayLabel $step.Status}}</td>
                                </tr>
                                {{end}}
                            </tbody>
                            <tfoot>
                                <tr class="border-t-2 border-knostic-border font-semibold text-knostic-navy">
                                    <td class="py-3 px-4">合计</td>
                                    <td class="py-3 px-4">{{.FormatDuration}}</td>
                                    <td class="py-3 px-4">{{.FormatTotalCost}}</td>
                                    <td class="py-3 px-4"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- Mobile: cards -->
                    <div class="sm:hidden space-y-3">
                        {{range .StepReports}}
                        <div class="bg-white border border-knostic-border rounded-card p-4">
                            <div class="font-mono font-semibold text-knostic-navy mb-2">{{displayLabel .Step}}</div>
                            <div class="grid grid-cols-2 gap-2 text-sm">
                                <div>
                                    <span class="text-knostic-muted">耗时</span>
                                    <div class="text-knostic-navy">{{.Duration}}</div>
                                </div>
                                <div>
                                    <span class="text-knostic-muted">预估费用</span>
                                    <div class="text-knostic-navy">{{.Cost}}</div>
                                </div>
                                <div>
                                    <span class="text-knostic-muted">状态</span>
                                    <div class="{{.StatusColor}} font-medium">{{displayLabel .Status}}</div>
                                </div>
                            </div>
                        </div>
                        {{end}}
                        <div class="bg-knostic-card-bg border-2 border-knostic-border rounded-card p-4">
                            <div class="font-semibold text-knostic-navy mb-2">合计</div>
                            <div class="grid grid-cols-2 gap-2 text-sm">
                                <div>
                                    <span class="text-knostic-muted">耗时</span>
                                    <div class="text-knostic-navy font-semibold">{{.FormatDuration}}</div>
                                </div>
                                <div>
                                    <span class="text-knostic-muted">预估费用</span>
                                    <div class="text-knostic-navy font-semibold">{{.FormatTotalCost}}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </details>
        </section>
        {{end}}

        <!-- All Findings (grouped by verdict) -->
        {{if .HasFindingGroups}}
        <section id="findings" class="mb-10 border-l-4 border-knostic-purple pl-4 sm:pl-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-knostic-navy mb-6">全部发现项</h2>
            <div class="space-y-4">
                {{range $g := .FindingsByVerdict}}
                <details{{if $g.OpenByDefault}} open{{end}} class="bg-white border border-knostic-border rounded-card">
                    <summary class="flex items-center gap-3 px-4 sm:px-5 py-3 hover:bg-knostic-purple-light rounded-card transition-colors cursor-pointer">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold text-white capitalize" style="background-color: {{$g.VerdictColor}}">{{displayLabel $g.Verdict}}</span>
                        <span class="text-knostic-navy font-medium text-sm">{{$g.Count}} 个发现项</span>
                    </summary>
                    <div class="px-4 sm:px-5 pb-4 pt-2 space-y-3">
                        {{if $g.HasSubgroups}}{{range $sg := $g.Subgroups}}
                        <div class="space-y-3">
                            <div class="flex items-center gap-2 pt-2">
                                <span class="text-xs font-semibold text-knostic-muted uppercase tracking-wide">{{displayLabel $sg.Label}}</span>
                                <span class="text-[10px] text-knostic-muted">({{len $sg.Findings}})</span>
                                <div class="flex-1 border-t border-knostic-border-light"></div>
                            </div>
                            {{range $f := $sg.Findings}}
                            <details id="finding-{{$f.Number}}" class="bg-knostic-card-bg border border-knostic-border-light rounded-lg group card-hover">
                                <summary class="flex flex-wrap items-center gap-2 sm:gap-3 px-4 sm:px-5 py-3 hover:bg-knostic-purple-light rounded-lg transition-colors">
                                    <span class="text-knostic-muted text-xs font-mono font-medium w-8">#{{$f.Number}}</span>
                                    {{if $f.Severity}}<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold text-white uppercase" style="background-color: {{$f.SeverityColor}}" title="严重程度来源：{{displayLabel $f.SeveritySource}}">{{displayLabel $f.Severity}}</span>{{end}}
                                    {{if $f.HasDynamicTest}}<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold text-white" style="background-color: {{$f.DynamicTestColor}}">{{displayLabel $f.DynamicTestStatus}}</span>{{end}}
                                    {{$url := $.FileURL $f.File}}{{if $url}}<a href="{{$url}}" target="_blank" rel="noopener" class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded text-knostic-purple hover:text-knostic-purple-hover transition-colors" onclick="event.stopPropagation()">{{$f.File}}</a>{{else}}<code class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded text-knostic-navy">{{$f.File}}</code>{{end}}
                                    <span class="font-mono text-xs text-knostic-muted">{{$f.Function}}</span>
                                    {{if $f.AttackVector}}<span class="text-xs text-knostic-muted hidden sm:inline">— {{$f.AttackVector}}</span>{{end}}
                                </summary>
                                <div class="px-4 sm:px-5 pb-4 pt-2 border-t border-knostic-border-light">
                                    {{if $f.AttackVector}}<div class="mb-3 sm:hidden"><span class="text-knostic-muted text-xs font-medium">攻击方式</span><p class="text-knostic-body text-sm mt-0.5">{{$f.AttackVector}}</p></div>{{end}}
                                    {{template "reskin-finding-details" $f}}
                                    {{if $f.DeferredTo}}{{/* #745: the SAFE row's followable edges — the block renders only when EDGES exist and states what the data IS, never a delegation CAUSE (the edge set is raw: every surviving non-entry unit has callers); a deferred unit with no result row is surfaced rowless. */}}<div class="mt-3 pt-3 border-t border-knostic-border-light"><span class="text-knostic-muted text-xs font-medium">调用关系（Call edges）</span><p class="text-knostic-body text-sm mt-0.5">分析范围 <code class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded">{{$f.Scope}}</code> — 本条记录仅涵盖当前函数；请沿调用关系查看潜在问题所在位置。</p>{{if $f.DeferredTo}}<p class="text-knostic-body text-xs mt-1 font-mono">关联目标：{{range $i, $d := $f.DeferredTo}}{{if $i}}, {{end}}<code class="bg-white border border-knostic-border-light px-2 rounded">{{$d}}</code>{{end}}</p>{{end}}{{if $f.DeferredRowless}}<p class="text-orange-500 text-xs mt-1 font-mono">无结果记录（已裁剪或尚未分析；no result row (pruned or never analyzed)）：{{range $i, $d := $f.DeferredRowless}}{{if $i}}, {{end}}<code class="bg-white border border-knostic-border-light px-2 rounded">{{$d}}</code>{{end}}</p>{{end}}</div>{{end}}
                                    {{if $f.HasDynamicTest}}<div class="mt-3 pt-3 border-t border-knostic-border-light"><span class="text-knostic-muted text-xs font-medium">动态测试</span><div class="flex items-center gap-2 mt-1"><span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white" style="background-color: {{$f.DynamicTestColor}}">{{displayLabel $f.DynamicTestStatus}}</span>{{if $f.DynamicTestDetails}}<span class="text-knostic-muted text-xs">{{$f.DynamicTestDetails}}</span>{{end}}</div></div>{{end}}
                                </div>
                            </details>
                            {{end}}
                        </div>
                        {{end}}{{else}}{{range $f := $g.Findings}}
                        <details id="finding-{{$f.Number}}" class="bg-knostic-card-bg border border-knostic-border-light rounded-lg group card-hover">
                            <summary class="flex flex-wrap items-center gap-2 sm:gap-3 px-4 sm:px-5 py-3 hover:bg-knostic-purple-light rounded-lg transition-colors">
                                <span class="text-knostic-muted text-xs font-mono font-medium w-8">#{{$f.Number}}</span>
                                {{if $f.Severity}}<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold text-white uppercase" style="background-color: {{$f.SeverityColor}}" title="严重程度来源：{{displayLabel $f.SeveritySource}}">{{displayLabel $f.Severity}}</span>{{end}}
                                {{if $f.HasDynamicTest}}<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold text-white" style="background-color: {{$f.DynamicTestColor}}">{{displayLabel $f.DynamicTestStatus}}</span>{{end}}
                                {{$url := $.FileURL $f.File}}{{if $url}}<a href="{{$url}}" target="_blank" rel="noopener" class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded text-knostic-purple hover:text-knostic-purple-hover transition-colors" onclick="event.stopPropagation()">{{$f.File}}</a>{{else}}<code class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded text-knostic-navy">{{$f.File}}</code>{{end}}
                                <span class="font-mono text-xs text-knostic-muted">{{$f.Function}}</span>
                                {{if $f.AttackVector}}<span class="text-xs text-knostic-muted hidden sm:inline">— {{$f.AttackVector}}</span>{{end}}
                            </summary>
                            <div class="px-4 sm:px-5 pb-4 pt-2 border-t border-knostic-border-light">
                                {{if $f.AttackVector}}<div class="mb-3 sm:hidden"><span class="text-knostic-muted text-xs font-medium">攻击方式</span><p class="text-knostic-body text-sm mt-0.5">{{$f.AttackVector}}</p></div>{{end}}
                                {{template "reskin-finding-details" $f}}
                                    {{if $f.DeferredTo}}{{/* #745: the SAFE row's followable edges — the block renders only when EDGES exist and states what the data IS, never a delegation CAUSE (the edge set is raw: every surviving non-entry unit has callers); a deferred unit with no result row is surfaced rowless. */}}<div class="mt-3 pt-3 border-t border-knostic-border-light"><span class="text-knostic-muted text-xs font-medium">调用关系（Call edges）</span><p class="text-knostic-body text-sm mt-0.5">分析范围 <code class="text-xs bg-white border border-knostic-border-light px-2 py-1 rounded">{{$f.Scope}}</code> — 本条记录仅涵盖当前函数；请沿调用关系查看潜在问题所在位置。</p>{{if $f.DeferredTo}}<p class="text-knostic-body text-xs mt-1 font-mono">关联目标：{{range $i, $d := $f.DeferredTo}}{{if $i}}, {{end}}<code class="bg-white border border-knostic-border-light px-2 rounded">{{$d}}</code>{{end}}</p>{{end}}{{if $f.DeferredRowless}}<p class="text-orange-500 text-xs mt-1 font-mono">无结果记录（已裁剪或尚未分析；no result row (pruned or never analyzed)）：{{range $i, $d := $f.DeferredRowless}}{{if $i}}, {{end}}<code class="bg-white border border-knostic-border-light px-2 rounded">{{$d}}</code>{{end}}</p>{{end}}</div>{{end}}
                                {{if $f.HasDynamicTest}}<div class="mt-3 pt-3 border-t border-knostic-border-light"><span class="text-knostic-muted text-xs font-medium">动态测试</span><div class="flex items-center gap-2 mt-1"><span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white" style="background-color: {{$f.DynamicTestColor}}">{{displayLabel $f.DynamicTestStatus}}</span>{{if $f.DynamicTestDetails}}<span class="text-knostic-muted text-xs">{{$f.DynamicTestDetails}}</span>{{end}}</div></div>{{end}}
                            </div>
                        </details>
                        {{end}}{{end}}
                    </div>
                </details>
                {{end}}
            </div>
        </section>
        {{end}}

        <!-- Footer -->
        <footer class="mt-10 sm:mt-12 pt-6 sm:pt-8 border-t border-knostic-border text-knostic-muted text-xs sm:text-sm text-center">
            <p>生成工具：911VulScan · 上游来源：<a href="https://knostic.ai" target="_blank" rel="noopener" class="text-knostic-purple font-semibold hover:text-knostic-purple-hover transition-colors">OpenAnt</a></p>
        </footer>
    </main>

    <!-- Charts -->
    <script>
        Chart.register(ChartDataLabels);

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { display: false },
                datalabels: {
                    color: '#fff',
                    font: { weight: 'bold', size: 11, family: 'system-ui' },
                    formatter: (value, ctx) => {
                        const total = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                        const pct = Math.round((value / total) * 100);
                        if (pct < 5) return '';
                        return ctx.chart.data.labels[ctx.dataIndex] + '\n' + pct + '%';
                    },
                    textAlign: 'center'
                }
            }
        };

        new Chart(document.getElementById('unitChart'), {
            type: 'pie',
            data: {
                labels: {{toJSON (displayLabels .UnitChart.Labels)}},
                datasets: [{
                    data: {{toJSON .UnitChart.Data}},
                    backgroundColor: {{toJSON .UnitChart.Colors}},
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: chartOptions
        });

        new Chart(document.getElementById('fileChart'), {
            type: 'pie',
            data: {
                labels: {{toJSON (displayLabels .FileChart.Labels)}},
                datasets: [{
                    data: {{toJSON .FileChart.Data}},
                    backgroundColor: {{toJSON .FileChart.Colors}},
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: chartOptions
        });
    </script>
</body>
</html>

{{define "reskin-finding-details"}}
<div><span class="text-knostic-muted text-xs font-medium">{{if .HasReportDetails}}发现项描述{{else}}分析{{end}}</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{if .Description}}{{.Description}}{{else if .Analysis}}{{.Analysis}}{{else}}未提供描述。{{end}}</p></div>
{{if .HasReportDetails}}
<p class="text-knostic-muted text-xs mt-1">以下描述、影响与修复方案来自分析记录，不代表已执行验证；建议修复示例需评审和回归测试。</p>
<div class="mt-3"><span class="text-knostic-muted text-xs font-medium">类型 / CWE</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{.CWELabel}}</p></div>
<div class="mt-3"><span class="text-knostic-muted text-xs font-medium">影响（分析评估）</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{if .Impact}}{{.Impact}}{{else}}未提供影响评估；需人工确认受影响对象和前提条件。{{end}}</p></div>
<div class="mt-3"><span class="text-knostic-muted text-xs font-medium">修复建议</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{if .Remediation}}{{.Remediation}}{{else}}未提供修复建议；需结合实际调用约束人工评估。{{end}}</p></div>
<details class="mt-3"><summary class="text-knostic-muted text-xs font-medium">相关漏洞代码（已有记录）</summary><pre class="text-knostic-body text-xs mt-1 whitespace-pre-wrap overflow-x-auto"><code>{{if .VulnerableCode}}{{.VulnerableCode}}{{else}}未提供代码片段；请按文件和函数定位源代码。{{end}}</code></pre></details>
<details class="mt-3"><summary class="text-knostic-muted text-xs font-medium">建议修复示例（未测试）</summary><pre class="text-knostic-body text-xs mt-1 whitespace-pre-wrap overflow-x-auto"><code>{{if .SuggestedFix}}{{.SuggestedFix}}{{else}}未提供可用的修复代码示例；未生成或验证补丁。{{end}}</code></pre></details>
<div class="mt-3"><span class="text-knostic-muted text-xs font-medium">复现思路（分析记录，非执行证据）</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{if .StepsToReproduce}}{{.StepsToReproduce}}{{else}}未记录复现步骤。{{end}}</p></div>
<div class="mt-3"><span class="text-knostic-muted text-xs font-medium">二阶段分析结论</span><p class="text-knostic-body text-sm mt-1 whitespace-pre-wrap leading-relaxed">{{if .Stage2Verification}}{{.Stage2Verification}}{{else}}未记录二阶段验证结论；不能视为已验证。{{end}}</p></div>
<details class="mt-3 pt-3 border-t border-knostic-border-light"><summary class="text-knostic-muted text-xs font-medium">动态验证：PoC 构建、运行与证据</summary><pre class="text-knostic-body text-xs mt-1 whitespace-pre-wrap overflow-x-auto">{{if .Reproduction}}{{.Reproduction}}{{else}}未记录可复核的 PoC 构建、触发步骤或执行证据；不据此宣称已复现。{{end}}</pre></details>
{{end}}
{{end}}
